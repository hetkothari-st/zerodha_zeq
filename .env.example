# --- Required ---
SUPABASE_URL=https://<op-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key (server only, never VITE_)
APP_ORIGIN=https://funnelop.in   # this product's public origin (used in emails)
HUB_SHARED_SECRET=               # same value on OP server, EQ server and ws-hub

# --- Feature flags ---
REQUIRE_MOBILE=false             # mobile OTP step on hold until SMS/DLT is live

# --- ws-hub ---
WS_HUB_URL=http://ws-hub.railway.internal:8765   # server → hub (private); port must match the hub's PORT (8765)
HUB_PUBLIC_URL=wss://<ws-hub-domain>             # browser → hub (for CSP)

# --- Branding / notifications ---
PRODUCT_NAME=Funnel Op
RESEND_API_KEY=
EMAIL_FROM=Funnel Op <hello@funnelop.in>
MSG91_AUTH_KEY=
MSG91_APPROVED_TEMPLATE_ID=      # DLT template with variables: name, product, link

# --- Zerodha Kite Connect ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=            # optional seed; normally set via /admin

# --- Payments (Razorpay). Billing is OFF (everything unlocked) unless all four are set. ---
RAZORPAY_KEY_ID=                 # rzp_test_… in staging, rzp_live_… in production (public)
RAZORPAY_KEY_SECRET=             # secret — never commit
RAZORPAY_WEBHOOK_SECRET=         # set when creating the webhook in the Razorpay dashboard
RAZORPAY_PLAN_ID=                # plan_… — one monthly plan per product
PRO_PRICE_LABEL=                 # shown in the upgrade modal, e.g. ₹499/month

# --- Front end (build-time, Plan 2) ---
VITE_SUPABASE_URL=https://<op-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_WS_HUB_URL=wss://<ws-hub-domain>
VITE_REQUIRE_MOBILE=false        # mobile OTP step on hold until SMS/DLT is live
