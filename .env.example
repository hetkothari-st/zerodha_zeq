# --- Required ---
SUPABASE_URL=https://<eq-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key (server only, never VITE_)
APP_ORIGIN=https://funneleq.in   # this product's public origin (used in emails)
HUB_SHARED_SECRET=               # same value on OP server, EQ server and ws-hub

# --- ws-hub ---
WS_HUB_URL=http://ws-hub.railway.internal:8765   # server → hub (private); port must match the hub's PORT (8765)
HUB_PUBLIC_URL=wss://<ws-hub-domain>             # browser → hub (for CSP)

# --- Branding / notifications ---
PRODUCT_NAME=Funnel Eq
RESEND_API_KEY=
EMAIL_FROM=Funnel Eq <hello@funneleq.in>
MSG91_AUTH_KEY=
MSG91_APPROVED_TEMPLATE_ID=      # DLT template with variables: name, product, link

# --- Zerodha Kite Connect ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=            # optional seed; normally set via /admin

# --- Front end (build-time, Plan 2) ---
VITE_SUPABASE_URL=https://<eq-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_WS_HUB_URL=wss://<ws-hub-domain>
