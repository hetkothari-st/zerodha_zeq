# --- ws-hub (Railway service) ---
# Listen port. Pin to 8765 on Railway so the servers' private
# WS_HUB_URL=http://ws-hub.railway.internal:8765 matches.
PORT=8765

# Shared secret for server → hub calls (X-Hub-Secret) — the same value as
# HUB_SHARED_SECRET on both the Funnel Op and Funnel Eq servers.
HUB_SHARED_SECRET=

# Browser origins allowed to open a WebSocket: comma-separated exact origins
# (scheme + host, no trailing slash, no wildcards).
HUB_ALLOWED_ORIGINS=https://funnelop.in,https://funneleq.in

# Supabase projects whose users may connect: a JSON array, one entry per product.
# serviceKey is that project's service_role key (server-side only).
SUPABASE_PROJECTS=[{"name":"op","url":"https://<op-project-ref>.supabase.co","serviceKey":"<op-service-role-key>"},{"name":"eq","url":"https://<eq-project-ref>.supabase.co","serviceKey":"<eq-service-role-key>"}]

# --- Zerodha Kite Connect ---
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=            # optional seed; normally pushed by the servers after an admin Kite login
